rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mohsenghodrat2@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator')
      );
    }

    function isAssignedToWorkshop(workshopData) {
      return isSignedIn() && (
        isAdmin() ||
        workshopData.createdBy == request.auth.uid ||
        (workshopData.assignedDeveloperIds is list && request.auth.uid in workshopData.assignedDeveloperIds)
      );
    }

    // User collection rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Workshop collection rules
    match /workshops/{workshopId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.assignedDeveloperIds is list && request.auth.uid in resource.data.assignedDeveloperIds) ||
        resource.data.status in ['Approved', 'Published']
      );

      allow create: if isSignedIn() && (
        request.resource.data.createdBy == request.auth.uid || isAdmin()
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.createdBy == request.auth.uid || (resource.data.assignedDeveloperIds is list && request.auth.uid in resource.data.assignedDeveloperIds))
        )
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.createdBy == request.auth.uid
      );
    }

    // Workshop Series collection rules
    match /workshopSeries/{seriesId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Materials collection rules
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uploadedBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uploadedBy == request.auth.uid
      );
    }
  }
}
